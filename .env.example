# LLM backend: "azure" (Azure OpenAI), "claude" (Anthropic), "groq" (cloud, compose default)
# or "ollama" (fully local)
LLM_BACKEND=groq

# Anthropic — required when LLM_BACKEND=claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Azure OpenAI — required when LLM_BACKEND=azure. Point it at a reasoning-model deployment
# (e.g. gpt-6-luna): the API refuses to start with LLM_BACKEND=azure if any of these three is missing.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# Optional: reasoning effort (none | low | medium | high | xhigh; default low), and the API version
# the browser agent uses (the text features use the versionless v1 API).
# AZURE_OPENAI_REASONING_EFFORT=low
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Groq API key — required when LLM_BACKEND=groq. Get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Ollama (used when LLM_BACKEND=ollama, and always for embeddings)
# Defaults are fine for Docker Compose; override only if needed.
# OLLAMA_HOST=http://ollama:11434
# OLLAMA_MODEL=qwen3.5:4b
# EMBEDDING_MODEL=nomic-embed-text

# JWT signing secret — REQUIRED. The API refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Encryption key for stored job-site passwords — REQUIRED. Changing it makes saved passwords
# unreadable (users just re-enter them). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# Brave Search API — optional, enables the Level 3 web-search job source. Free tier at https://brave.com/search/api
BRAVE_SEARCH_API_KEY=

# Adzuna Jobs API — optional, enables the Adzuna job source. Free tier at https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# LLM reading of job ads (seniority, years of experience, degree, sponsorship, clearance) runs in the
# background, one call per new job. On by default except with the local Ollama model; 1 / 0 forces it.
# JOB_ATTRIBUTES_LLM=1

# The Home Office register of licensed sponsors is downloaded from gov.uk weekly (about 11 MB) to
# flag employers that can sponsor visas. Set to 0 to stop downloading it (a stored copy is still used).
# SPONSOR_REGISTER_REFRESH=1

# Job-site login credentials are set per user on the Profile page (stored encrypted with
# CREDENTIALS_KEY) — they are not configured here.

# Frontend only — NOT read from this file and not needed with Docker Compose (nginx routes
# /api to the API). When the frontend runs without nginx (npm run dev, Vercel), its /api
# proxy forwards to API_URL: set it in frontend/.env or the Vercel project's env vars.
# API_URL=http://localhost:8000

# ── Gmail tracking (optional) ─────────────────────────────────────────────────
# Lets Windrush read your job emails (read-only) and update your applications. In Google Cloud Console:
#   1. Create a project, then APIs & Services > Library > enable the "Gmail API".
#   2. OAuth consent screen: User type External, publishing status Testing; add your own Gmail address as a
#      test user; add the scope .../auth/gmail.readonly.
#   3. Credentials > Create credentials > OAuth client ID > Web application, with the authorised redirect URI
#      http://localhost/api/gmail/callback
# Google ends a testing-mode app's access every 7 days: Windrush then asks you to connect again.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost/api/gmail/callback

# ── Profile suggestions (optional) ────────────────────────────────────────────
# Windrush reads your public GitHub repositories to suggest projects and skills. Without a token GitHub allows
# 60 requests an hour, enough for one read. A fine-grained token with no permissions (public data only) lifts it.
# GITHUB_TOKEN=
